<Project Sdk="Microsoft.NET.Sdk">
  <!-- The reader's tests (dotnet test tests/Orecchiante.Tests). Unit tests of the helpers that need nothing, and
       Recording.cs: a recording made here read by orecchiante.exe end to end, which needs the models in onnx/
       (tools/fetch-models.ps1; CI fetches them, .github/workflows/ci.yml). Windows only, as the reader is. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Orecchiante\Orecchiante.csproj" />
  </ItemGroup>
</Project>
