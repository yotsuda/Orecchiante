{
  "name": "dettato",
  "displayName": "Dettato Chord Chart Transcriber",
  "description": "Reads a recording into an editable Lily# (.lys) chord chart: tempo, meter, key, bar lines and the chord of every bar, with the uncertain places marked. Open source (Apache-2.0). Runs locally on Windows; no cloud.",
  "version": "0.1.0",
  "publisher": "yotsuda",
  "icon": "icon.png",
  "author": "Yoshifumi Tsuda",
  "preview": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/yotsuda/Dettato.git"
  },
  "bugs": {
    "url": "https://github.com/yotsuda/Dettato/issues"
  },
  "homepage": "https://github.com/yotsuda/Dettato#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "chord recognition",
    "transcription",
    "chord chart",
    "audio",
    "lilysharp"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "dettato.transcribe",
        "title": "Transcribe Recording to Lily# Chord Chart (.lys)… (Preview)",
        "category": "Dettato"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "dettato.transcribe",
          "when": "resourceExtname =~ /^\\.wav$/i && isWindows",
          "group": "navigation@90"
        }
      ]
    }
  }
}
