<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Orecchiante</RootNamespace>
    <!-- orecchiante.exe in development as in an extension's bin (as calamo.exe is) -->
    <AssemblyName>orecchiante</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- the two models trained on recordings run locally through ONNX Runtime, the version Calamo has -->
    <PackageReference Include="LibNMeCab" Version="0.10.2" />
    <PackageReference Include="LibNMeCab.IpaDicBin" Version="0.10.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
    <!-- mp3, m4a, flac and the rest through Windows' Media Foundation (Audio.cs): NAudio is the way to it (MIT) -->
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- tests/Orecchiante.Tests reaches the internal helpers (Bass.Pieces, Words.Seconds, ...) -->
    <InternalsVisibleTo Include="Orecchiante.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- what Sections weighs a bar line's cues with: written by scratch/xsc/dp.py with json, read by tools/read_chords.py too -->
    <EmbeddedResource Include="..\..\tools\sections_dp.json" LogicalName="sections_dp.json" />
  </ItemGroup>
</Project>
